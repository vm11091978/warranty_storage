{% extends 'base.html.twig' %}

{% block title %}Авторизация{% endblock %}

{% block body %}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-8 col-md-6 col-lg-4">
            <h1 class="mb-4">Авторизация</h1>

            <form class="w-100" style="max-width: 400px;" method="post">
                {# Ошибка авторизации #}
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {# Email #}
                <div class="mb-3">
                    <label for="email" class="form-label">E-mail</label>
                    <input type="email" id="email" name="_username" class="form-control" value="{{ last_username }}" required>
                </div>

                {# Password #}
                <div class="mb-4">
                    <label for="password" class="form-label">Пароль</label>
                    <input type="password" id="password" name="_password" class="form-control" required>
                </div>

                {# CSRF token #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn btn-primary w-100">
                    Войти
                </button>
            </form>
        </div>
    </div>
</div>

{% endblock %}
